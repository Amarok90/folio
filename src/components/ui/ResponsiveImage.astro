---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
}
const { src, alt, sizes, priority = false } = Astro.props;
const widths = [320, 640, 960, 1280].filter((width) => width < src.width);
---

<Image
  src={src}
  alt={alt}
  widths={[...widths, src.width]}
  sizes={sizes}
  format="webp"
  class="responsive-image"
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={priority ? 'high' : 'auto'}
/>
