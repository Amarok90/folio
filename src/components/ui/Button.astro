---
import Icon, { type IconName } from './Icon.astro';
type Props = {
  variant?: 'primary' | 'secondary';
  icon?: IconName;
  class?: string;
} & (
  | {
      href: string;
      disabled?: never;
      type?: never;
      download?: boolean;
      external?: boolean;
    }
  | {
      href?: never;
      disabled?: boolean;
      type?: 'button' | 'submit' | 'reset';
      download?: never;
      external?: never;
    }
);
const {
  href,
  variant = 'primary',
  icon,
  disabled,
  type = 'button',
  download,
  external = false,
  class: className,
  ...attributes
} = Astro.props;
---

{href ? (
  <a
    {...attributes}
    href={href}
    download={download}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class:list={['button', `button--${variant}`, className]}
  >
    <slot />
    {icon && <Icon name={icon} />}
    {external && <span class="sr-only"> (opens in a new tab)</span>}
  </a>
) : (
  <button
    {...attributes}
    type={type}
    disabled={disabled}
    class:list={['button', `button--${variant}`, className]}
  >
    <slot />
    {icon && <Icon name={icon} />}
  </button>
)}
