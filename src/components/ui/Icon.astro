---
import {
  ArrowRight,
  ArrowUpRight,
  ArrowUp,
  Check,
  ChevronDown,
  CodeXml,
  Download,
  Feather,
  FileCheck,
  Layers,
  Menu,
  Palette,
  ShieldCheck,
  Type,
  X,
  Image,
  CircleCheck,
  Users,
  BriefcaseBusiness,
  MapPin,
  Globe,
  Mail,
  Target,
  Database,
  Workflow,
  ChartNoAxesCombined,
  Contact,
  ClipboardList,
  Building,
  Languages,
  GraduationCap,
  Compass,
  Link,
  Shield,
} from '@lucide/astro';

const icons = {
  arrow: ArrowRight,
  external: ArrowUpRight,
  up: ArrowUp,
  check: Check,
  chevron: ChevronDown,
  code: CodeXml,
  download: Download,
  feather: Feather,
  file: FileCheck,
  layers: Layers,
  menu: Menu,
  palette: Palette,
  shield: ShieldCheck,
  type: Type,
  close: X,
  image: Image,
  complete: CircleCheck,
  users: Users,
  briefcase: BriefcaseBusiness,
  location: MapPin,
  globe: Globe,
  mail: Mail,
  target: Target,
  database: Database,
  workflow: Workflow,
  chart: ChartNoAxesCombined,
  contact: Contact,
  clipboard: ClipboardList,
  building: Building,
  languages: Languages,
  education: GraduationCap,
  compass: Compass,
  link: Link,
  security: Shield,
};
export type IconName = keyof typeof icons | 'linkedin';
interface Props {
  name: IconName;
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
const Glyph = name === 'linkedin' ? undefined : icons[name];
---

<span
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  class:list={['icon', className]}
>
  {Glyph ? (
    <Glyph size={20} stroke-width={1.7} aria-hidden="true" focusable="false" />
  ) : (
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <!-- LinkedIn mark: Simple Icons 11.15.0, CC0; see public/icons/NOTICE.md. -->
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
    </svg>
  )}
</span>
