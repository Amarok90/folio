---
import { interfaceContent as ui } from '../../data/interface';
import Button from './Button.astro';
import { profile } from '../../data/profile';
import { isPublished } from '../../lib/content';
import { withBasePath } from '../../lib/urls';
interface Props {
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { variant = 'secondary', class: className = '' } = Astro.props;
const publicProfile = isPublished(profile) ? profile : null;
---

{publicProfile?.cv ? (
  <Button
    href={withBasePath(publicProfile.cv.path, import.meta.env.BASE_URL)}
    download={publicProfile.cv.filename}
    data-analytics-event="cv_download"
    variant={variant}
    class={className}
    icon="download"
  >
    {ui.actions.cvDownloadLabel}
  </Button>
) : publicProfile?.cvPreviewUrl ? (
  <Button
    href={publicProfile?.cvPreviewUrl}
    external
    data-analytics-event="cv_view"
    variant={variant}
    class={className}
    icon="external"
  >
    {ui.actions.cvViewLabel}
  </Button>
) : (
  <Button disabled variant={variant} class={className} icon="download">
    {ui.actions.cvPendingLabel}
  </Button>
)}
