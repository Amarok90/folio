---
import { interfaceContent as ui } from '../../data/interface';
import Button from './Button.astro';
import { profile } from '../../data/profile';
import { isPublished } from '../../lib/content';
import { withBasePath } from '../../lib/urls';
interface Props {
  variant?: 'primary' | 'secondary';
  class?: string;
  showPreview?: boolean;
}
const {
  variant = 'secondary',
  class: className = '',
  showPreview = false,
} = Astro.props;
const publicProfile = isPublished(profile) ? profile : null;
const localPDF = publicProfile?.cv
  ? withBasePath(publicProfile.cv.path, import.meta.env.BASE_URL)
  : null;
---

{publicProfile?.cv && localPDF ? (
  <>
    {showPreview && (
      <Button
        href={localPDF}
        external
        data-analytics-event="cv_view"
        variant={variant}
        class={className}
        icon="external"
      >
        {ui.actions.cvViewLabel}
      </Button>
    )}
    <Button
      href={localPDF}
      download={publicProfile.cv.filename}
      data-analytics-event="cv_download"
      variant={variant}
      class={className}
      icon="download"
    >
      {ui.actions.cvDownloadLabel}
    </Button>
  </>
) : publicProfile?.cvPreviewUrl ? (
  <Button
    href={publicProfile?.cvPreviewUrl}
    external
    data-analytics-event="cv_view"
    variant={variant}
    class={className}
    icon="external"
  >
    {ui.actions.cvViewLabel}
  </Button>
) : (
  <Button disabled variant={variant} class={className} icon="download">
    {ui.actions.cvPendingLabel}
  </Button>
)}
