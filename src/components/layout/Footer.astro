---
import { interfaceContent as ui } from '../../data/interface';
import Container from './Container.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';
import { media } from '../../config/media';
import { site } from '../../config/site';
import { profile } from '../../data/profile';
import { withBasePath } from '../../lib/urls';
const homeURL = withBasePath('/', import.meta.env.BASE_URL);
const linkedIn = profile.contact.links.find((link) =>
  link.url.includes('linkedin.com/in/'),
);
---

<footer class="footer-shell">
  <Container class="footer-inner">
    <div class="footer-identity">
      <a href={`${homeURL}#home`} class="brand">
        {media.logo ? (
          <Image
            src={media.logo}
            alt={media.logoAlt}
            width={32}
            height={32}
            class="brand-logo"
          />
        ) : (
          <Icon name="feather" />
        )}
        <span class="brand-wordmark">{site.brand}</span>
      </a>
      <p>
        <strong>{site.identity.name}</strong>
        <span>{site.identity.jobTitle}</span>
      </p>
    </div>
    <nav aria-label="Footer navigation">
      {site.navigation.map((item) => (
        <a href={`${homeURL}${item.href}`}>{item.label}</a>
      ))}
    </nav>
    <div class="footer-social">
      {linkedIn && (
        <a
          href={linkedIn.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile (opens in a new tab)"
          data-analytics-event="linkedin_click"
        >
          <Icon name="linkedin" />
        </a>
      )}
      {profile.contact.email && (
        <a
          href={`mailto:${profile.contact.email}`}
          aria-label={`${ui.common.emailLabel} ${profile.identity.name}`}
          data-analytics-event="email_click"
        >
          <Icon name="mail" />
        </a>
      )}
    </div>
    <div class="footer-privacy">
      <a href={withBasePath('/privacy/', import.meta.env.BASE_URL)}>
        {ui.footer.privacyLabel}
      </a>
      <button type="button" data-consent-open hidden>
        {ui.footer.preferencesLabel}
      </button>
    </div>
    <p class="copyright">
      © {new Date().getUTCFullYear()} {site.identity.name}
      <span>{ui.footer.copyrightNotice}</span>
    </p>
    <a href={`${homeURL}#home`} class="footer-top">
      {ui.footer.backToTopLabel}
      <Icon name="up" />
    </a>
  </Container>
</footer>

<style>
  .brand-wordmark {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .brand-logo {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    flex-shrink: 0;
  }
  .footer-privacy {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }
  .footer-privacy a,
  .footer-privacy button {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .footer-privacy button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .footer-privacy a:hover,
  .footer-privacy button:hover {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
