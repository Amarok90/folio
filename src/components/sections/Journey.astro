---
import { interfaceContent as ui } from '../../data/interface';
import { getCollection } from 'astro:content';
import { publishedEntries } from '../../lib/content';
import Badge from '../ui/Badge.astro';
import CVAction from '../ui/CVAction.astro';
import Icon from '../ui/Icon.astro';

const experience = publishedEntries(await getCollection('experience'));
const timeline = experience.map(({ id, data }) => ({
  ...data,
  id: `experience-${id}`,
  title: data.role,
}));
const skills = new Map(
  publishedEntries(await getCollection('skills')).map(({ id, data }) => [
    id,
    data.name,
  ]),
);
const monthLabel = (date: string): string => {
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(year!, month! - 1)));
};
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="portfolio-section portfolio-section--stacked journey"
>
  <div class="section-intro journey__intro">
    <p class="eyebrow">{ui.journey.eyebrow}</p>
    <h2 id="experience-title">{ui.journey.titleLines.join(' ')}</h2>
    <p>
      {timeline.length > 0
        ? ui.journey.description
        : ui.journey.emptyDescription}
    </p>
    <CVAction variant="secondary" />
  </div>

  <div class="section-body journey__body">
    {timeline.length > 0 ? (
      <ol class="career-timeline" aria-label="Professional experience">
        {timeline.map((entry) => (
          <li class="career-step" id={entry.id}>
            <p class="career-step__date">
              <time datetime={entry.startDate}>
                {monthLabel(entry.startDate)}
              </time>
              <span aria-hidden="true"> — </span>
              {entry.endDate ? (
                <time datetime={entry.endDate}>
                  {monthLabel(entry.endDate)}
                </time>
              ) : (
                <span>{ui.journey.presentLabel}</span>
              )}
            </p>
            <span class="career-step__icon">
              <Icon name={entry.current ? 'briefcase' : 'users'} />
            </span>
            <div class="career-step__content">
              <div class="career-step__heading">
                <div>
                  <h3>{entry.title}</h3>
                  <p class="career-step__organization">
                    {entry.organization}
                    {entry.location && ` · ${entry.location}`}
                  </p>
                </div>
              </div>
              {(entry.summary ||
                entry.achievements.length > 0 ||
                entry.skillIds.length > 0) && (
                <details class="career-step__details">
                  <summary>
                    {ui.journey.detailsLabel} <Icon name="chevron" />
                  </summary>
                  {entry.summary && (
                    <p class="career-step__summary">{entry.summary}</p>
                  )}
                  {entry.achievements.length > 0 && (
                    <ul class="career-step__achievements">
                      {entry.achievements.map((achievement) => (
                        <li>
                          <Icon name="check" />
                          <span>{achievement}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {entry.skillIds.length > 0 && (
                    <div
                      class="career-step__additional-skills"
                      aria-label="Skills used"
                    >
                      {entry.skillIds.map(
                        (skillId) =>
                          skills.has(skillId) && (
                            <Badge>{skills.get(skillId)}</Badge>
                          ),
                      )}
                    </div>
                  )}
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p>{ui.journey.emptyMessage}</p>
    )}
  </div>
</section>

<style>
  .career-timeline {
    --timeline-date-width: 7.25rem;
    --timeline-marker-size: 2.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .career-step {
    position: relative;
    display: grid;
    grid-template-columns:
      var(--timeline-date-width) var(--timeline-marker-size)
      minmax(0, 1fr);
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }
  .career-step::before {
    position: absolute;
    content: '';
    top: 0;
    bottom: 0;
    left: calc(
      var(--timeline-date-width) + var(--space-4) +
        var(--timeline-marker-size) / 2
    );
    width: 1px;
    background: var(--color-border);
  }
  .career-step:first-child::before {
    top: calc(var(--timeline-marker-size) / 2);
  }
  .career-step:last-child::before {
    bottom: calc(100% - var(--timeline-marker-size) / 2);
  }
  .career-step:last-child {
    padding-bottom: 0;
  }
  .career-step__date {
    padding-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .career-step__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--timeline-marker-size);
    height: var(--timeline-marker-size);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary-text);
  }
  .career-step__icon :global(.icon) {
    width: var(--space-5);
    height: var(--space-5);
  }
  .career-step__content {
    min-width: 0;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-divider);
  }
  .career-step:last-child .career-step__content {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .career-step__heading {
    min-width: 0;
  }
  .career-step h3 {
    font-size: var(--text-small);
    line-height: 1.5;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
  .career-step__organization,
  .career-step__summary {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.65;
  }
  .career-step__summary {
    max-width: 60ch;
    margin-top: var(--space-1);
  }
  .career-step__additional-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .career-step__additional-skills :global(.badge) {
    font-size: var(--text-caption);
    padding: var(--space-1) var(--space-2);
  }
  .career-step__details summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    list-style: none;
    color: var(--color-primary-text);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    cursor: pointer;
    text-underline-offset: 0.25em;
  }
  .career-step__details summary::-webkit-details-marker {
    display: none;
  }
  .career-step__details summary:hover {
    text-decoration: underline;
  }
  .career-step__details summary :global(.icon) {
    width: var(--space-3);
    height: var(--space-3);
    transition: transform var(--duration-normal) var(--ease-standard);
  }
  .career-step__details[open] summary :global(.icon) {
    transform: rotate(180deg);
  }
  .career-step__details .career-step__summary {
    margin-block: 0 var(--space-3);
  }
  .career-step__achievements {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.6;
  }
  .career-step__achievements li {
    display: flex;
    align-items: start;
    gap: var(--space-2);
  }
  .career-step__achievements :global(.icon) {
    width: var(--space-3);
    height: var(--space-5);
    color: var(--color-primary-text);
  }
  .career-step__additional-skills {
    margin-top: var(--space-3);
  }
  @media (width < 64rem) {
    .career-timeline {
      --timeline-marker-size: 2.5rem;
    }
    .career-step {
      grid-template-columns: var(--timeline-marker-size) minmax(0, 1fr);
      gap: var(--space-2) var(--space-3);
    }
    .career-step::before {
      left: calc(var(--timeline-marker-size) / 2);
    }
    .career-step__icon {
      grid-row: 1 / 3;
      grid-column: 1;
    }
    .career-step__date {
      grid-column: 2;
      padding-top: var(--space-1);
      text-align: left;
    }
    .career-step__content {
      grid-column: 2;
    }
  }
  @media (width < 48rem) {
    .career-step {
      padding-bottom: var(--space-5);
    }
  }
</style>
