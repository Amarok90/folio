---
import { interfaceContent as ui } from '../../data/interface';
import { getCollection } from 'astro:content';
import { publishedEntries } from '../../lib/content';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';

const experience = publishedEntries(await getCollection('experience'));
const timeline = experience.map(({ id, data }) => ({
  ...data,
  id: `experience-${id}`,
  title: data.role,
  expandable:
    Boolean(data.summary) ||
    data.achievements.length > 0 ||
    data.skillIds.length > 0,
}));
const skills = new Map(
  publishedEntries(await getCollection('skills')).map(({ id, data }) => [
    id,
    data.name,
  ]),
);
const monthLabel = (date: string): string => {
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(year!, month! - 1)));
};
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="portfolio-section portfolio-section--stacked journey"
>
  <div class="section-intro journey__intro">
    <p class="eyebrow">{ui.journey.eyebrow}</p>
    <h2 id="experience-title">{ui.journey.titleLines.join(' ')}</h2>
    <p>
      {timeline.length > 0
        ? ui.journey.description
        : ui.journey.emptyDescription}
    </p>
  </div>

  <div class="section-body journey__body">
    {timeline.length > 0 ? (
      <ol class="career-timeline" aria-label="Professional experience">
        {timeline.map((entry) => {
          const Entry = entry.expandable ? 'details' : 'div';
          const Heading = entry.expandable ? 'summary' : 'div';
          return (
            <li
              class:list={[
                'career-step',
                { 'career-step--current': entry.current },
              ]}
              id={entry.id}
            >
              <p class="career-step__date">
                <time datetime={entry.startDate}>
                  {monthLabel(entry.startDate)}
                </time>
                <span aria-hidden="true"> — </span>
                {entry.endDate ? (
                  <time datetime={entry.endDate}>
                    {monthLabel(entry.endDate)}
                  </time>
                ) : (
                  <span>{ui.journey.presentLabel}</span>
                )}
              </p>
              <span class="career-step__marker" aria-hidden="true"></span>
              <div class="career-step__content">
                <Entry
                  class="career-step__details"
                  data-card-disclosure={entry.expandable ? '' : undefined}
                  open={entry.expandable && entry.current ? true : undefined}
                >
                  <Heading class="career-step__toggle">
                    {entry.current && (
                      <span class="career-step__icon" aria-hidden="true">
                        <Icon name="briefcase" />
                      </span>
                    )}
                    <div class="career-step__heading">
                      <h3 id={`${entry.id}-title`}>{entry.title}</h3>
                      <p class="career-step__organization">
                        {entry.organization}
                        {entry.location && ` · ${entry.location}`}
                      </p>
                    </div>
                    {entry.current && (
                      <span class="career-step__current">
                        <span aria-hidden="true"></span>
                        {ui.journey.currentLabel}
                      </span>
                    )}
                    {entry.expandable && (
                      <>
                        <span class="sr-only">{ui.journey.detailsLabel}</span>
                        <Icon name="chevron" class="career-step__chevron" />
                      </>
                    )}
                  </Heading>
                  {entry.expandable && (
                    <div class="career-step__body">
                      {entry.summary && (
                        <p class="career-step__summary">{entry.summary}</p>
                      )}
                      {entry.achievements.length > 0 && (
                        <ul class="career-step__achievements">
                          {entry.achievements.map((achievement) => (
                            <li>{achievement}</li>
                          ))}
                        </ul>
                      )}
                      {entry.skillIds.length > 0 && (
                        <div
                          class="career-step__additional-skills"
                          aria-label="Skills used"
                        >
                          {entry.skillIds.map(
                            (skillId) =>
                              skills.has(skillId) && (
                                <Badge>{skills.get(skillId)}</Badge>
                              ),
                          )}
                        </div>
                      )}
                    </div>
                  )}
                </Entry>
              </div>
            </li>
          );
        })}
      </ol>
    ) : (
      <p>{ui.journey.emptyMessage}</p>
    )}
  </div>
</section>

<style>
  .career-timeline {
    --timeline-date-width: 8rem;
    --timeline-marker-size: 0.75rem;
    --timeline-marker-offset: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .career-step {
    position: relative;
    display: grid;
    grid-template-columns:
      var(--timeline-date-width) var(--timeline-marker-size)
      minmax(0, 1fr);
    gap: var(--space-5);
    padding-bottom: var(--space-1);
  }
  .career-step::before {
    position: absolute;
    content: '';
    top: 0;
    bottom: 0;
    left: calc(
      var(--timeline-date-width) + var(--space-5) +
        var(--timeline-marker-size) / 2
    );
    width: 1px;
    background: var(--color-border);
  }
  .career-step:first-child::before {
    top: var(--timeline-marker-offset);
  }
  .career-step:last-child::before {
    bottom: calc(100% - var(--timeline-marker-offset));
  }
  .career-step:last-child {
    padding-bottom: 0;
  }
  .career-step__date {
    padding-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    line-height: 1.65;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .career-step__date time {
    white-space: nowrap;
  }
  .career-step--current .career-step__date {
    color: var(--color-primary-text);
    font-weight: var(--weight-semibold);
  }
  .career-step__marker {
    position: relative;
    width: var(--timeline-marker-size);
    height: var(--timeline-marker-size);
    margin-top: calc(
      var(--timeline-marker-offset) - var(--timeline-marker-size) / 2
    );
    border: 2px solid var(--color-surface);
    border-radius: var(--radius-pill);
    background: var(--color-primary-text);
    box-shadow: 0 0 0 1px var(--color-divider);
  }
  .career-step--current .career-step__marker {
    background: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-background-secondary);
  }
  .career-step__content {
    min-width: 0;
  }
  .career-step__details {
    border-bottom: 1px solid var(--color-divider);
  }
  details.career-step__details[data-card-disclosure] {
    cursor: pointer;
  }
  .career-step:last-child .career-step__details {
    border-bottom: 0;
  }
  .career-step--current .career-step__details {
    margin-bottom: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: color-mix(
      in srgb,
      var(--color-background-secondary) 45%,
      var(--color-surface)
    );
  }
  .career-step__toggle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.25rem;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--touch-target);
    padding: var(--space-3) var(--space-4);
    list-style: none;
    border-radius: var(--radius-small);
  }
  .career-step--current .career-step__toggle {
    grid-template-columns: var(--space-12) minmax(0, 1fr) auto 1.25rem;
    padding-block: var(--space-4);
  }
  .career-step__toggle::-webkit-details-marker {
    display: none;
  }
  summary.career-step__toggle:hover {
    background: var(--color-background);
  }
  summary.career-step__toggle:focus-visible {
    outline-offset: 3px;
  }
  .career-step__heading {
    min-width: 0;
  }
  .career-step h3 {
    font-size: var(--text-small);
    line-height: 1.5;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
  .career-step__organization,
  .career-step__summary {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .career-step__icon {
    display: grid;
    place-items: center;
    width: var(--space-12);
    height: var(--space-12);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary-text);
  }
  .career-step__icon :global(.icon) {
    width: var(--space-5);
    height: var(--space-5);
  }
  .career-step__current {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-2);
    max-width: 12rem;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-background-secondary);
    color: var(--color-primary-text);
    font-size: var(--text-caption);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .career-step__current > span {
    flex: 0 0 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary-text);
    box-shadow: 0 0 0 3px var(--color-surface);
  }
  .career-step__toggle :global(.career-step__chevron) {
    width: 1rem;
    height: 1rem;
    color: var(--color-primary-text);
    justify-self: end;
    transition: transform var(--duration-normal) var(--ease-standard);
  }
  .career-step__details[open]
    > .career-step__toggle
    :global(.career-step__chevron) {
    transform: rotate(180deg);
  }
  .career-step__body {
    padding: 0 var(--space-4) var(--space-5);
  }
  .career-step--current .career-step__body {
    padding-left: calc(var(--space-4) + var(--space-12) + var(--space-4));
  }
  .career-step__summary {
    max-width: 75ch;
    margin-bottom: var(--space-3);
  }
  .career-step__achievements {
    display: grid;
    gap: var(--space-1);
    list-style: disc;
    margin: 0;
    padding-left: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.6;
  }
  .career-step__achievements li {
    padding-left: var(--space-1);
  }
  .career-step__achievements li::marker {
    color: var(--color-primary-text);
  }
  .career-step__additional-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .career-step__additional-skills :global(.badge) {
    font-size: var(--text-caption);
    padding: var(--space-1) var(--space-2);
  }
  @media (width < 64rem) {
    .career-timeline {
      --timeline-date-width: 6.5rem;
    }
    .career-step {
      gap: var(--space-3);
    }
    .career-step::before {
      left: calc(
        var(--timeline-date-width) + var(--space-3) +
          var(--timeline-marker-size) / 2
      );
    }
    .career-step--current .career-step__toggle {
      grid-template-columns: var(--space-10) minmax(0, 1fr) 1.25rem;
      gap: var(--space-3);
    }
    .career-step__icon {
      width: var(--space-10);
      height: var(--space-10);
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .career-step__current {
      grid-column: 2;
      justify-self: start;
      max-width: 100%;
    }
    .career-step--current .career-step__toggle :global(.career-step__chevron) {
      grid-column: 3;
      grid-row: 1 / 3;
    }
    .career-step--current .career-step__body {
      padding-left: var(--space-4);
    }
  }
  @media (width < 48rem) {
    .career-step {
      grid-template-columns: var(--timeline-marker-size) minmax(0, 1fr);
      gap: 0 var(--space-3);
      padding-bottom: var(--space-3);
    }
    .career-step::before {
      left: calc(var(--timeline-marker-size) / 2);
    }
    .career-step__marker {
      grid-column: 1;
      grid-row: 1 / 3;
      margin-top: var(--space-1);
    }
    .career-step:first-child::before {
      top: calc(var(--timeline-marker-size) / 2 + var(--space-1));
    }
    .career-step:last-child::before {
      bottom: calc(100% - var(--timeline-marker-size) / 2 - var(--space-1));
    }
    .career-step__date {
      grid-column: 2;
      padding: 0 var(--space-3) var(--space-2);
      text-align: left;
    }
    .career-step__content {
      grid-column: 2;
    }
    .career-step__toggle {
      padding-inline: var(--space-3);
    }
    .career-step--current .career-step__toggle {
      grid-template-columns: minmax(0, 1fr) 1rem;
    }
    .career-step__icon {
      display: none;
    }
    .career-step__current {
      grid-column: 1;
      padding-inline: var(--space-2);
    }
    .career-step--current .career-step__toggle :global(.career-step__chevron) {
      grid-column: 2;
    }
    .career-step__body,
    .career-step--current .career-step__body {
      padding-inline: var(--space-3);
    }
  }
</style>
