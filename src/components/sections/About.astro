---
import { interfaceContent as ui } from '../../data/interface';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { media } from '../../config/media';
import { profile } from '../../data/profile';
import { isPublished, publishedEntries } from '../../lib/content';
import Icon from '../ui/Icon.astro';

interface Props {
  image: ImageMetadata;
  background?: ImageMetadata;
}
const { image, background } = Astro.props;
const education = publishedEntries(await getCollection('education'));
const languages = publishedEntries(await getCollection('languages'));
const publicProfile = isPublished(profile) ? profile : null;
const approachIcons = ['contact', 'workflow', 'users', 'shield'] as const;
const approach = profile.about.approach.map((item, index) => ({
  ...item,
  icon: approachIcons[index] ?? 'shield',
}));
const monthLabel = (date: string): string => {
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(year!, month! - 1)));
};
---

<section
  id="about"
  aria-labelledby="about-title"
  class="portfolio-section about"
>
  <div class="section-intro about__heading">
    <p class="eyebrow">{ui.about.eyebrow}</p>
    <h2 id="about-title">{ui.about.titleLines.join(' ')}</h2>
  </div>
  <figure class="about__portrait">
    {background && (
      <Image
        class="about__landscape"
        src={background}
        alt=""
        widths={[480, 720]}
        sizes="(max-width: 639px) 90vw, (max-width: 1023px) 40vw, 25vw"
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="about__portrait-mist" aria-hidden="true" />
    <Image
      class="about__person"
      src={image}
      alt={media.portraitAlt}
      widths={[320, 480, 720]}
      sizes="(max-width: 639px) 90vw, (max-width: 1023px) 40vw, 25vw"
      loading="lazy"
      decoding="async"
    />
    {media.portraitTemporary && (
      <figcaption>{ui.common.portraitNote}</figcaption>
    )}
  </figure>

  <div class="section-intro about__intro">
    <p>{publicProfile?.about.summary ?? ui.about.emptyDescription}</p>
    {publicProfile && publicProfile.about.interests.length > 0 && (
      <ul class="about__interests" aria-label="Personal interests">
        {publicProfile.about.interests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    )}
    <a class="text-link about__story" href={ui.about.action.href}>
      {ui.about.action.label} <Icon name="arrow" />
    </a>
  </div>

  <div class="section-body about__body">
    <div class="about__approach-heading">
      <Icon name="complete" />
      <h3>{ui.about.approachTitle}</h3>
      {!publicProfile && <span>Approach preview</span>}
    </div>
    <ol
      class="approach-list"
      aria-label={
        publicProfile ? 'My working approach' : 'Proposed approach presentation'
      }
    >
      {approach.map((item) => (
        <li>
          <span class="approach-list__icon">
            <Icon name={item.icon} />
          </span>
          <div>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  {(education.length > 0 ||
    languages.length > 0 ||
    publicProfile?.contact.location) && (
    <div class="about__details">
      {education.length > 0 && (
        <div class="about-detail about-detail--education">
          <Icon name="education" />
          <div>
            <h3 id="about-education-title">{ui.about.educationTitle}</h3>
            <ol class="education-list" aria-labelledby="about-education-title">
              {education.map(({ id, data }) => (
                <li id={`education-${id}`}>
                  <h4>{data.qualification}</h4>
                  <p>{data.institution}</p>
                  {data.field && <p>{data.field}</p>}
                  <p class="education-dates">
                    <time datetime={data.startDate}>
                      {monthLabel(data.startDate)}
                    </time>
                    <span aria-hidden="true"> — </span>
                    {data.endDate ? (
                      <time datetime={data.endDate}>
                        {monthLabel(data.endDate)}
                      </time>
                    ) : (
                      <span>{ui.common.ongoingLabel}</span>
                    )}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}
      {languages.length > 0 && (
        <div class="about-detail">
          <Icon name="languages" />
          <div>
            <h3>{ui.about.languagesTitle}</h3>
            <ul>
              {languages.map(({ data }) => (
                <li>
                  {data.name}
                  {data.proficiency && ` · ${data.proficiency}`}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {publicProfile?.contact.location && (
        <div class="about-detail">
          <Icon name="location" />
          <div>
            <h3>{ui.common.locationLabel}</h3>
            <p>{publicProfile.contact.location}</p>
            {publicProfile.contact.openToRelocation === true && (
              <p>{ui.common.relocationLabel}</p>
            )}
          </div>
        </div>
      )}
    </div>
  )}
</section>

<style>
  .about.portfolio-section {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.15fr) minmax(0, 1.25fr);
    gap: clamp(var(--space-6), 3vw, var(--space-10));
    align-items: start;
  }
  .about__heading {
    grid-column: 1 / -1;
  }
  .about__heading h2 {
    max-width: none;
    margin-bottom: 0;
  }
  .about__intro > p:not(.eyebrow) {
    max-width: 44ch;
    font-size: var(--text-small);
    line-height: 1.75;
  }
  .about__story {
    margin-top: var(--space-6);
  }
  .about__interests {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding-left: var(--space-4);
    margin-block: var(--space-4) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
  .about__portrait {
    position: relative;
    align-self: stretch;
    min-width: 0;
    min-height: 22rem;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-background-secondary);
  }
  .about__portrait .about__landscape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
  }
  .about__portrait-mist {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-background-secondary) 16%, transparent),
      color-mix(in srgb, var(--color-background-secondary) 8%, transparent) 60%,
      color-mix(in srgb, var(--color-background-secondary) 55%, transparent)
    );
  }
  .about__portrait .about__person {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .about__portrait figcaption {
    position: absolute;
    inset: auto var(--space-3) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.45;
    text-align: center;
  }
  .about__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .about__approach-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .about__approach-heading > :global(.icon) {
    width: var(--space-4);
    height: var(--space-4);
    color: var(--color-primary-text);
  }
  .about__approach-heading h3 {
    font-size: var(--text-h5);
    letter-spacing: -0.025em;
  }
  .about__approach-heading > span {
    margin-left: auto;
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .approach-list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .approach-list li {
    display: flex;
    align-items: start;
    gap: var(--space-3);
  }
  .approach-list__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--space-10);
    height: var(--space-10);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary-text);
  }
  .approach-list h4 {
    font-size: var(--text-small);
    letter-spacing: -0.01em;
    line-height: 1.5;
  }
  .approach-list p {
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.65;
  }
  .about__details {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-divider);
  }
  .about-detail {
    display: flex;
    align-items: start;
    gap: var(--space-2);
    min-width: 0;
  }
  .about-detail > div {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .about-detail > :global(.icon) {
    width: var(--space-4);
    height: var(--space-4);
    color: var(--color-primary-text);
  }
  .about-detail h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-small);
    letter-spacing: 0;
    line-height: 1.5;
  }
  .about-detail h4 {
    font-size: var(--text-caption);
    line-height: 1.65;
    letter-spacing: 0;
  }
  .about-detail p,
  .about-detail ul {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.65;
  }
  .education-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .education-dates {
    margin-top: var(--space-1);
    font-variant-numeric: tabular-nums;
  }
  .about-detail ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-detail li + li {
    margin-top: var(--space-2);
  }
  @media (width < 64rem) {
    .about.portfolio-section {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-8);
    }
    .about__body {
      grid-column: 1 / -1;
    }
    .approach-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  @media (width < 40rem) {
    .about.portfolio-section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    .about__portrait {
      aspect-ratio: 4 / 5;
      width: min(100%, 22rem);
      min-height: 0;
      justify-self: center;
    }
    .approach-list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
</style>
