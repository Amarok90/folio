---
import { interfaceContent as ui } from '../../data/interface';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { media } from '../../config/media';
import { profile } from '../../data/profile';
import { isPublished, publishedEntries } from '../../lib/content';
import Icon from '../ui/Icon.astro';

const [educationEntries, languageEntries] = await Promise.all([
  getCollection('education'),
  getCollection('languages'),
]);
const education = publishedEntries(educationEntries);
const languages = publishedEntries(languageEntries);
const publicProfile = isPublished(profile) ? profile : null;
const approachIcons = ['target', 'workflow', 'users', 'chart'] as const;
const approach = profile.about.approach.map((item, index) => ({
  ...item,
  icon: approachIcons[index] ?? 'target',
}));
const hasPersonalDetails =
  education.length > 0 ||
  languages.length > 0 ||
  Boolean(publicProfile?.contact.location) ||
  (publicProfile?.about.interests.length ?? 0) > 0;
const monthLabel = (date: string): string => {
  const [year, month] = date.split('-').map(Number);
  return new Intl.DateTimeFormat('en', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(year!, month! - 1)));
};
---

<section
  id="about"
  aria-labelledby="about-title"
  class:list={[
    'portfolio-section',
    'about',
    { 'about--without-details': !hasPersonalDetails },
  ]}
>
  <p class="eyebrow about__eyebrow">{ui.about.eyebrow}</p>
  <figure class="about__portrait">
    <Image
      class="about__person"
      src={media.aboutPortrait}
      alt={media.aboutPortraitAlt}
      widths={[320, 480, 720, 960]}
      sizes="(max-width: 25rem) 85vw, (max-width: 47.99rem) 352px, (max-width: 63.99rem) 30vw, 400px"
      loading="lazy"
      decoding="async"
    />
    {media.aboutPortraitTemporary && (
      <figcaption>{ui.common.portraitNote}</figcaption>
    )}
  </figure>

  <div class="section-intro about__intro">
    <h2 id="about-title">{ui.about.titleLines.join(' ')}</h2>
    <p>{publicProfile?.about.summary ?? ui.about.emptyDescription}</p>
  </div>

  <div class="section-body about__body">
    <h3 class="about__approach-heading">{ui.about.approachTitle}</h3>
    <ol
      class="approach-list"
      aria-label={
        publicProfile ? 'My working approach' : 'Proposed approach presentation'
      }
    >
      {approach.map((item) => (
        <li>
          <span class="approach-list__icon">
            <Icon name={item.icon} />
          </span>
          <div>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <a class="text-link about__story" href={ui.about.action.href}>
      {ui.about.action.label} <Icon name="arrow" />
    </a>
  </div>

  {hasPersonalDetails && (
    <aside class="about__details" aria-label="Personal information">
      {education.length > 0 && (
        <div class="about-detail about-detail--education">
          <Icon name="education" />
          <div>
            <h3 id="about-education-title">{ui.about.educationTitle}</h3>
            <ol class="education-list" aria-labelledby="about-education-title">
              {education.map(({ id, data }) => (
                <li id={`education-${id}`}>
                  <h4>{data.qualification}</h4>
                  <p>{data.institution}</p>
                  {data.field && <p>{data.field}</p>}
                  <p class="education-dates">
                    <time datetime={data.startDate}>
                      {monthLabel(data.startDate)}
                    </time>
                    <span aria-hidden="true"> — </span>
                    {data.endDate ? (
                      <time datetime={data.endDate}>
                        {monthLabel(data.endDate)}
                      </time>
                    ) : (
                      <span>{ui.common.ongoingLabel}</span>
                    )}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      )}
      {languages.length > 0 && (
        <div class="about-detail">
          <Icon name="languages" />
          <div>
            <h3>{ui.about.languagesTitle}</h3>
            <ul>
              {languages.map(({ data }) => (
                <li>
                  {data.name}
                  {data.proficiency && ` · ${data.proficiency}`}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {publicProfile?.contact.location && (
        <div class="about-detail">
          <Icon name="location" />
          <div>
            <h3>{ui.common.locationLabel}</h3>
            <p>{publicProfile.contact.location}</p>
            {publicProfile.contact.openToRelocation === true && (
              <p>{ui.common.relocationLabel}</p>
            )}
          </div>
        </div>
      )}
      {publicProfile && publicProfile.about.interests.length > 0 && (
        <div class="about-detail">
          <Icon name="compass" />
          <div>
            <h3>{ui.about.interestsTitle}</h3>
            <ul class="about__interests">
              {publicProfile.about.interests.map((interest) => (
                <li>{interest}</li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </aside>
  )}
</section>

<style>
  .about.portfolio-section {
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.65fr) minmax(0, 0.8fr);
    align-items: start;
    gap: var(--space-5) clamp(var(--space-5), 2.5vw, var(--space-8));
  }
  .about__eyebrow {
    grid-column: 1 / -1;
  }
  .about__portrait {
    position: relative;
    grid-column: 1;
    grid-row: 2 / 4;
    align-self: start;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-width: 0;
    min-height: 0;
    max-height: 26rem;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-background-secondary);
  }
  .about__person {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 70%;
  }
  .about__portrait figcaption {
    position: absolute;
    inset: auto var(--space-3) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.45;
    text-align: center;
  }
  .about__intro {
    grid-column: 2;
    grid-row: 2;
  }
  .about__intro h2 {
    max-width: none;
    margin-block: var(--space-1) var(--space-3);
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .about__intro > p:not(.eyebrow) {
    max-width: none;
    font-size: var(--text-small);
    line-height: 1.7;
  }
  .about__body {
    grid-column: 2;
    grid-row: 3;
    min-width: 0;
  }
  .about__approach-heading {
    margin-bottom: var(--space-4);
    color: var(--color-primary-text);
    font-size: var(--text-small);
    line-height: 1.5;
    letter-spacing: 0;
  }
  .approach-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .approach-list li {
    display: grid;
    grid-template-columns: var(--space-8) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2);
    min-width: 0;
  }
  .approach-list__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-8);
    height: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-background-secondary);
    color: var(--color-primary-text);
  }
  .approach-list__icon :global(.icon) {
    width: var(--space-4);
    height: var(--space-4);
  }
  .approach-list h4 {
    font-size: var(--text-caption);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  .approach-list p {
    margin-top: var(--space-1);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.6;
  }
  .about__story {
    margin-top: var(--space-4);
  }
  .about__details {
    grid-column: 3;
    grid-row: 2 / 4;
    display: grid;
    align-content: start;
    gap: var(--space-6);
    align-self: stretch;
    min-width: 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }
  .about-detail {
    display: grid;
    grid-template-columns: var(--space-5) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2);
    min-width: 0;
  }
  .about-detail > :global(.icon) {
    width: var(--space-5);
    height: var(--space-5);
    color: var(--color-primary-text);
  }
  .about-detail > div,
  .about__intro,
  .approach-list li > div {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .about-detail h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-caption);
    line-height: 1.5;
    letter-spacing: 0;
  }
  .about-detail h4 {
    font-size: var(--text-caption);
    line-height: 1.6;
    letter-spacing: 0;
  }
  .about-detail p,
  .about-detail ul {
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.6;
  }
  .education-list,
  .about-detail ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .education-list {
    display: grid;
    gap: var(--space-4);
  }
  .education-dates {
    margin-top: var(--space-1);
    font-variant-numeric: tabular-nums;
  }
  .about-detail ul li + li {
    margin-top: var(--space-1);
  }
  .about--without-details .about__intro,
  .about--without-details .about__body {
    grid-column: 2 / -1;
  }
  @media (width < 64rem) {
    .about.portfolio-section {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.7fr);
      gap: var(--space-6);
    }
    .about__details {
      grid-column: 1 / -1;
      grid-row: 4;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
      padding-top: var(--space-5);
      padding-left: 0;
      border-top: 1px solid var(--color-divider);
      border-left: 0;
    }
  }
  @media (width < 48rem) {
    .about.portfolio-section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .about__intro,
    .about--without-details .about__intro {
      grid-column: 1;
      grid-row: 2;
    }
    .about__portrait {
      grid-column: 1;
      grid-row: 3;
      width: min(100%, 22rem);
      justify-self: center;
    }
    .about__body,
    .about--without-details .about__body {
      grid-column: 1;
      grid-row: 4;
    }
    .about__details {
      grid-row: 5;
    }
    .about__intro h2 {
      font-size: var(--text-h2);
    }
  }
  @media (width < 25rem) {
    .approach-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
