---
import { interfaceContent as ui } from '../../data/interface';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { media } from '../../config/media';
import Icon, { type IconName } from '../ui/Icon.astro';
import { publishedEntries, type SkillProficiency } from '../../lib/content';

interface Skill {
  id: string;
  name: string;
  proficiency: SkillProficiency;
  selfAssessment: number | null;
}
interface Category {
  id: string;
  title: string;
  description: string | null;
  icon: IconName;
  skills: Skill[];
}

const [expertiseEntries, skillEntries] = await Promise.all([
  getCollection('expertise'),
  getCollection('skills'),
]);
const categories = publishedEntries(expertiseEntries);
const skills = publishedEntries(skillEntries);
const specifiedProficiency = skills.filter(
  (skill) => skill.data.proficiency !== null,
).length;
const panels: Category[] = categories.map((category) => ({
  id: category.id,
  title: category.data.title,
  description: category.data.description,
  icon: 'file',
  skills: skills
    .filter((skill) => skill.data.categoryId === category.id)
    .map((skill) => ({
      id: skill.id,
      name: skill.data.name,
      proficiency: skill.data.proficiency,
      selfAssessment: skill.data.selfAssessment,
    })),
}));
---

<section
  id="expertise"
  class:list={[
    'portfolio-section',
    'expertise-section',
    { 'expertise-section--text-only': !media.analytics },
  ]}
  aria-labelledby="expertise-title"
>
  <div class="expertise-content">
    <div class="section-intro expertise-intro">
      <p class="eyebrow">{ui.expertise.eyebrow}</p>
      <h2 id="expertise-title">{ui.expertise.titleLines.join(' ')}</h2>
      <p class="section-description">{ui.expertise.description}</p>
      <a
        class="text-link expertise-section-link"
        href={ui.expertise.action.href}
      >
        {ui.expertise.action.label} <Icon name="arrow" />
      </a>
    </div>
    <div class="section-body expertise-widget" data-expertise-tabs>
      {panels.length > 0 && (
        <div class="expertise-tabs" data-tab-list>
          {panels.map((panel) => (
            <a
              class="expertise-tab"
              id={`expertise-tab-${panel.id}`}
              href={`#expertise-panel-${panel.id}`}
              data-expertise-tab
            >
              {panel.title}
            </a>
          ))}
        </div>
      )}
      {panels.map((panel) => (
        <div
          id={`expertise-panel-${panel.id}`}
          class="expertise-panel"
          data-expertise-panel
        >
          <h3 class="expertise-panel-title">{panel.title}</h3>
          {panel.description && (
            <p class="expertise-panel-description">{panel.description}</p>
          )}
          {panel.skills.length > 0 ? (
            <ul
              class="skills-list"
              style={`--skill-rows: ${Math.ceil(panel.skills.length / 2)}`}
            >
              {panel.skills.map((skill) => (
                <li class="skill-row">
                  <span class="skill-icon">
                    <Icon name={panel.icon} />
                  </span>
                  <span class="skill-name">
                    {skill.name}
                    {skill.proficiency !== null && (
                      <small class="skill-proficiency">
                        {skill.proficiency}
                      </small>
                    )}
                  </span>
                  {skill.selfAssessment !== null && (
                    <span class="skill-score">
                      <meter
                        min="1"
                        max="100"
                        value={skill.selfAssessment}
                        aria-label={`${skill.name} self-assessment`}
                      >
                        {skill.selfAssessment} out of 100
                      </meter>
                      <span class="skill-score-value" aria-hidden="true">
                        {skill.selfAssessment}
                      </span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="expertise-empty">{ui.expertise.emptySkillsMessage}</p>
          )}
        </div>
      ))}
      {panels.length === 0 ? (
        <p class="expertise-empty">{ui.expertise.emptyMessage}</p>
      ) : (
        skills.length > 0 && (
          <p class="expertise-preview-note">
            {ui.expertise.footnote}
            {skills.some((skill) => skill.data.selfAssessment !== null) && (
              <span>Numeric levels are self-assessed, on a 1–100 scale.</span>
            )}
            {specifiedProficiency < skills.length && (
              <span class="sr-only">
                {specifiedProficiency === 0
                  ? ui.expertise.proficiencyNote
                  : ui.expertise.partialProficiencyNote}
              </span>
            )}
          </p>
        )
      )}
    </div>
  </div>
  {media.analytics && (
    <figure class="expertise-visual">
      <Image
        src={media.analytics}
        alt={media.analyticsAlt}
        widths={[400, 640, 900]}
        sizes="(max-width: 767px) 90vw, 400px"
        format="webp"
        loading="lazy"
        decoding="async"
        class="expertise-image"
      />
      {media.analyticsIllustrative && (
        <figcaption>{ui.projects.illustrativeCaption}</figcaption>
      )}
    </figure>
  )}
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-expertise-tabs]')
    .forEach((widget) => {
      const tabList = widget.querySelector<HTMLElement>('[data-tab-list]');
      const tabs = Array.from(
        widget.querySelectorAll<HTMLAnchorElement>('[data-expertise-tab]'),
      );
      const panels = Array.from(
        widget.querySelectorAll<HTMLElement>('[data-expertise-panel]'),
      );
      if (!tabList || tabs.length === 0 || tabs.length !== panels.length)
        return;

      tabList.setAttribute('role', 'tablist');
      tabList.setAttribute('aria-label', 'Expertise categories');
      tabs.forEach((tab, index) => {
        const panel = panels[index];
        if (!panel) return;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        panel.tabIndex = 0;
      });

      const activate = (index: number, moveFocus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          const panel = panels[tabIndex];
          if (panel) panel.hidden = !selected;
        });
        if (moveFocus) tabs[index]?.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', (event) => {
          event.preventDefault();
          activate(index);
        });
        tab.addEventListener('keydown', (event) => {
          let nextIndex: number;
          switch (event.key) {
            case 'ArrowRight':
              nextIndex = (index + 1) % tabs.length;
              break;
            case 'ArrowLeft':
              nextIndex = (index - 1 + tabs.length) % tabs.length;
              break;
            case 'Home':
              nextIndex = 0;
              break;
            case 'End':
              nextIndex = tabs.length - 1;
              break;
            case ' ':
              event.preventDefault();
              activate(index);
              return;
            default:
              return;
          }
          event.preventDefault();
          activate(nextIndex, true);
        });
      });

      // A fragment link remains meaningful when the page is opened without JS.
      const fragmentIndex = panels.findIndex(
        (panel) => `#${panel.id}` === window.location.hash,
      );
      activate(fragmentIndex >= 0 ? fragmentIndex : 0);
      widget.dataset.enhanced = '';
    });
</script>

<style>
  .expertise-section {
    grid-template-columns: minmax(0, 1.86fr) minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-8);
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }
  .expertise-content {
    min-width: 0;
    padding-block: var(--space-4);
  }
  .expertise-section--text-only .expertise-content {
    grid-column: 1 / -1;
  }
  .expertise-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .expertise-intro > .eyebrow,
  .expertise-intro > h2,
  .expertise-intro > .section-description {
    grid-column: 1;
  }
  .expertise-intro h2 {
    max-width: none;
    margin-block: var(--space-3);
  }
  .expertise-intro > .section-description {
    max-width: 54ch;
  }
  .expertise-intro .text-link {
    grid-column: 2;
    grid-row: 2 / 4;
    align-self: center;
    max-width: 9rem;
    margin-top: 0;
  }
  .expertise-widget {
    min-width: 0;
  }
  .expertise-tabs {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-1);
    margin: calc(-1 * var(--space-1));
    margin-bottom: var(--space-5);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }
  .expertise-tab {
    flex: 1 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-small);
    background: var(--color-background-secondary);
    color: var(--color-secondary);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      background var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }
  .expertise-tab:hover {
    background: var(--color-border);
  }
  .expertise-tab[aria-selected='true'] {
    border-color: transparent;
    background: var(--gradient-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-button);
  }
  .expertise-panel {
    padding-block: var(--space-2);
  }
  .expertise-panel + .expertise-panel {
    margin-top: var(--space-6);
  }
  .expertise-panel-title {
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }
  .expertise-widget[data-enhanced] .expertise-panel-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .expertise-widget[data-enhanced] .expertise-panel {
    margin-top: 0;
  }
  .expertise-panel-description,
  .expertise-empty {
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
  .skills-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--skill-rows), auto);
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skill-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--space-8);
    min-width: 0;
  }
  .skill-icon {
    display: inline-flex;
    color: var(--color-primary-text);
    flex-shrink: 0;
  }
  .skill-icon :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .skill-name {
    flex: 1;
    min-width: 0;
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  .skill-proficiency {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    text-transform: capitalize;
  }
  .skill-score {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 37%;
  }
  meter {
    width: 100%;
    min-width: 0;
    height: 0.375rem;
    appearance: none;
    border: 0;
    background: var(--color-divider);
    border-radius: var(--radius-pill);
  }
  meter::-webkit-meter-bar {
    height: 0.375rem;
    background: var(--color-divider);
    border: 0;
    border-radius: var(--radius-pill);
  }
  meter::-webkit-meter-optimum-value {
    background: var(--gradient-primary);
    border-radius: var(--radius-pill);
  }
  meter::-moz-meter-bar {
    background: var(--gradient-primary);
    border-radius: var(--radius-pill);
  }
  .skill-score-value {
    width: 3ch;
    flex-shrink: 0;
    text-align: right;
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
  }
  .expertise-preview-note {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .expertise-visual {
    position: relative;
    margin: 0;
    min-width: 0;
    border-radius: var(--radius-section);
    overflow: hidden;
    background: var(--color-background-secondary);
    box-shadow: var(--shadow-card);
  }
  .expertise-image {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: 58% center;
  }
  figcaption {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    color: var(--color-text-muted);
    background: var(--color-surface);
    font-size: 0.625rem;
    border-radius: var(--radius-small);
    padding: var(--space-1) var(--space-2);
  }
  @media (width < 64rem) {
    .expertise-section {
      grid-template-columns: minmax(0, 1fr);
    }
    .expertise-visual {
      aspect-ratio: 16 / 9;
    }
    .skill-name {
      font-size: var(--text-small);
    }
  }
  @media (width < 48rem) {
    .skills-list {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-flow: row;
      grid-template-rows: none;
    }
    .expertise-section {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .expertise-content {
      padding: 0;
    }
    .expertise-visual {
      aspect-ratio: 3 / 2;
    }
    .skill-row {
      min-height: var(--space-10);
    }
    .expertise-intro {
      display: block;
      margin-bottom: var(--space-5);
    }
    .expertise-intro .text-link {
      max-width: none;
      margin-top: var(--space-2);
    }
  }
</style>
