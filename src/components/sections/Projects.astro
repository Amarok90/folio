---
import { interfaceContent as ui } from '../../data/interface';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';
import { publishedEntries } from '../../lib/content';
import { resolveImage } from '../../config/media';

interface Props {
  thumbnails?: readonly ImageMetadata[];
}
const { thumbnails = [] } = Astro.props;
const projects = publishedEntries(await getCollection('caseStudies'));
const skills = new Map(
  publishedEntries(await getCollection('skills')).map(({ id, data }) => [
    id,
    data.name,
  ]),
);
---

<section
  id="projects"
  class="portfolio-section portfolio-section--stacked projects-section"
  aria-labelledby="projects-title"
>
  <div class="section-intro">
    <p class="eyebrow">{ui.projects.eyebrow}</p>
    <h2 id="projects-title">{ui.projects.titleLines.join(' ')}</h2>
    <p class="section-description">
      {projects.length === 0
        ? ui.projects.emptyDescription
        : ui.projects.description}
    </p>
    <a class="text-link projects-section-link" href={ui.projects.action.href}>
      {ui.projects.action.label} <Icon name="arrow" />
    </a>
  </div>
  <div class="section-body">
    {projects.length > 0 && (
      <div class="project-grid">
        {projects.map((project, index) => (
          <details
            class="project-card"
            data-card-disclosure
            aria-labelledby={`${project.id}-title`}
          >
            <summary class="project-overview">
              <span class="project-image-wrap">
                {project.data.image ? (
                  <Image
                    src={resolveImage(project.data.image.path)}
                    alt={project.data.image.alt}
                    widths={[320, 480, 720]}
                    sizes="(max-width: 47.99rem) 90vw, (max-width: 63.99rem) 44vw, (max-width: 80rem) 30vw, 364px"
                    width={720}
                    loading="lazy"
                    decoding="async"
                    class="project-image"
                  />
                ) : thumbnails[index] ? (
                  <Image
                    src={thumbnails[index]}
                    alt=""
                    widths={[320, 480, 720]}
                    sizes="(max-width: 47.99rem) 90vw, (max-width: 63.99rem) 44vw, (max-width: 80rem) 30vw, 364px"
                    width={720}
                    loading="lazy"
                    class="project-image"
                  />
                ) : (
                  <span class="project-image-placeholder" aria-hidden="true">
                    <Icon name="layers" />
                  </span>
                )}
                {project.data.sector && (
                  <span class="project-sector">{project.data.sector}</span>
                )}
                {(project.data.image?.illustrative ||
                  (!project.data.image && thumbnails[index])) && (
                  <span class="project-image-caption">
                    {ui.projects.illustrativeCaption}
                  </span>
                )}
              </span>
              <h3 class="project-heading" id={`${project.id}-title`}>
                <span>{project.data.title}</span>
                <Icon name="chevron" class="project-chevron" />
              </h3>
              <span class="project-summary">{project.data.summary}</span>
              {project.data.outcomes.length > 0 && (
                <span class="project-points" role="list">
                  {project.data.outcomes.map((outcome) => (
                    <span role="listitem">
                      <Icon name="complete" />
                      <span>{outcome}</span>
                    </span>
                  ))}
                </span>
              )}
              <span class="sr-only" id={`${project.id}-details-label`}>
                {ui.projects.detailsLabel}
              </span>
            </summary>
            <div class="project-details-body">
              <h4>{ui.projects.challengeHeading}</h4>
              <p>{project.data.challenge}</p>
              <h4>{ui.projects.contributionHeading}</h4>
              <p>{project.data.contribution}</p>
              {project.data.skillIds.length > 0 && (
                <div class="project-skills" aria-label="Skills used">
                  {project.data.skillIds.map(
                    (skillId) =>
                      skills.has(skillId) && (
                        <Badge>{skills.get(skillId)}</Badge>
                      ),
                  )}
                </div>
              )}
              {project.data.limitations.length > 0 && (
                <>
                  <h4>{ui.projects.limitationsHeading}</h4>
                  <ul>
                    {project.data.limitations.map((limitation) => (
                      <li>{limitation}</li>
                    ))}
                  </ul>
                </>
              )}
              {project.data.link && (
                <a
                  class="project-external"
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.data.link.startsWith('https://www.linkedin.com/')
                    ? ui.projects.linkedInSourceLabel
                    : ui.projects.sourceLabel}
                  <Icon name="external" />
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </div>
          </details>
        ))}
      </div>
    )}
    {projects.length === 0 && (
      <p class="section-description">{ui.projects.emptyMessage}</p>
    )}
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--space-4);
  }
  .project-card {
    min-width: 0;
    overflow: clip;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-border);
      box-shadow: var(--shadow-elevated);
    }
    .project-card:hover .project-image {
      transform: scale(1.025);
    }
  }
  .project-card:focus-within {
    border-color: var(--color-primary-text);
    box-shadow: var(--shadow-elevated);
  }
  .project-overview {
    display: block;
    padding-bottom: var(--space-5);
    list-style: none;
    cursor: pointer;
  }
  .project-overview::-webkit-details-marker {
    display: none;
  }
  .project-overview:focus-visible {
    outline-offset: -4px;
  }
  .project-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-5) var(--space-5) 0;
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }
  .project-heading :global(.project-chevron) {
    width: var(--space-4);
    height: var(--space-4);
    margin-top: var(--space-1);
    color: var(--color-primary-text);
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .project-card[open] :global(.project-chevron) {
    transform: rotate(180deg);
  }
  .project-image-wrap {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--color-background-secondary);
    aspect-ratio: 1.85;
  }
  .project-image,
  .project-image-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project-image {
    transition: transform var(--duration-normal) var(--ease-standard);
  }
  .project-image-placeholder {
    display: grid;
    place-items: center;
    color: var(--color-primary-text);
    background: linear-gradient(
      135deg,
      var(--color-background-secondary),
      var(--color-border)
    );
  }
  .project-image-placeholder :global(.icon) {
    width: var(--space-10);
    height: var(--space-10);
  }
  .project-sector {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: var(--radius-small);
    color: var(--color-on-primary);
    background: var(--gradient-primary);
    box-shadow: var(--shadow-card);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
  }
  .project-image-caption {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.625rem;
    line-height: 1.4;
  }
  .project-status {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.625rem;
    line-height: 1.5;
  }
  .project-summary {
    display: block;
    margin: var(--space-2) var(--space-5) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.6;
  }
  .project-points {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: var(--space-3) var(--space-5) 0;
  }
  .project-points [role='listitem'] {
    display: flex;
    align-items: start;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  .project-points :global(.icon) {
    width: 0.875rem;
    height: 0.875rem;
    margin-top: 0.125rem;
    color: var(--color-primary-text);
  }
  .project-details-body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border-top: 1px solid var(--color-divider);
    font-size: var(--text-caption);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .project-details-body h4 {
    margin-top: var(--space-2);
    font-size: var(--text-caption);
    letter-spacing: 0;
    line-height: 1.5;
  }
  .project-details-body ul {
    padding-left: var(--space-4);
    margin: 0;
  }
  .project-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }
  .project-image-note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .project-external {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target);
    color: var(--color-primary-text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .projects-section-link {
    margin-top: var(--space-4);
  }
  .projects-preview-note {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  @media (width < 64rem) and (width >= 48rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .project-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .project-card:last-child:nth-child(odd) > .project-overview {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-bottom: 0;
    }
    .project-card:last-child:nth-child(odd) .project-image-wrap {
      grid-column: 1;
      grid-row: 1 / 4;
      aspect-ratio: auto;
      min-height: 100%;
    }
    .project-card:last-child:nth-child(odd) .project-heading,
    .project-card:last-child:nth-child(odd) .project-summary,
    .project-card:last-child:nth-child(odd) .project-points {
      grid-column: 2;
    }
    .project-card:last-child:nth-child(odd) .project-summary,
    .project-card:last-child:nth-child(odd) .project-points {
      margin-bottom: var(--space-5);
    }
    .project-card:last-child:nth-child(odd) .project-points {
      margin-top: 0;
    }
  }
  @media (width < 48rem) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
    .project-heading {
      font-size: var(--text-h4);
    }
    .project-summary,
    .project-points [role='listitem'] {
      font-size: var(--text-small);
    }
    .project-status {
      font-size: var(--text-caption);
    }
    .project-details-body {
      font-size: var(--text-small);
    }
    .projects-section-link {
      margin-top: var(--space-2);
    }
  }
</style>
