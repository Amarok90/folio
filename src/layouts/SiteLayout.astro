---
import '../styles/global.css';
import fontURL from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site';
import { canonicalURL, serializeJsonLd, withBasePath } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  socialImage?: string;
  person?: { name: string; jobTitle: string; sameAs?: string[] };
}
const {
  title = site.title,
  description = site.description,
  noindex = !site.indexable,
  socialImage,
  person,
} = Astro.props;
const canonical = canonicalURL(
  Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') ||
    '/',
  Astro.site,
  import.meta.env.BASE_URL,
);
const image =
  socialImage && Astro.site
    ? new URL(withBasePath(socialImage, import.meta.env.BASE_URL), Astro.site)
        .href
    : undefined;
const faviconURL = withBasePath('/icons/favicon.svg', import.meta.env.BASE_URL);
const jsonLd = person
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      ...person,
      ...(canonical ? { url: canonical } : {}),
    }
  : undefined;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b2b53" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <link
      rel="preload"
      href={fontURL}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={faviconURL} type="image/svg+xml" />
    {jsonLd && (
      <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
