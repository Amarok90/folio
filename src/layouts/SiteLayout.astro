---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { media, resolveImage } from '../config/media';
import Consent from '../components/ui/Consent.astro';
import fontURL from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site';
import { canonicalURL, serializeJsonLd, withBasePath } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  socialImage?: string;
  canonical?: boolean;
  person?: { name: string; jobTitle: string; sameAs?: string[] };
}
const {
  title = site.title,
  description = site.description,
  noindex = !site.indexable,
  socialImage,
  canonical: emitCanonical = true,
  person,
} = Astro.props;
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath =
  basePrefix && Astro.url.pathname.startsWith(`${basePrefix}/`)
    ? Astro.url.pathname.slice(basePrefix.length)
    : Astro.url.pathname;
const canonical = emitCanonical
  ? canonicalURL(pagePath, Astro.site, import.meta.env.BASE_URL)
  : undefined;
const sharingImage = await getImage({
  src: socialImage
    ? resolveImage(socialImage)
    : (media.socialImage ?? media.alpine),
  width: 1200,
  height: 630,
  format: 'webp',
});
const image = Astro.site
  ? new URL(sharingImage.src, Astro.site).href
  : undefined;
const favicon = media.logo
  ? await getImage({ src: media.logo, width: 32, height: 32, format: 'png' })
  : undefined;
const faviconURL =
  favicon?.src ?? withBasePath('/icons/favicon.svg', import.meta.env.BASE_URL);
const jsonLd = person
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      ...person,
      ...(canonical ? { url: canonical } : {}),
    }
  : undefined;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b2b53" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content={
            media.socialImageAlt ||
            'Alpine landscape used in the FOLIO professional portfolio'
          }
        />
        <meta name="twitter:image" content={image} />
        <meta
          name="twitter:image:alt"
          content={
            media.socialImageAlt ||
            'Alpine landscape used in the FOLIO professional portfolio'
          }
        />
      </>
    )}
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <link
      rel="preload"
      href={fontURL}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="icon"
      href={faviconURL}
      type={favicon ? 'image/png' : 'image/svg+xml'}
    />
    {jsonLd && (
      <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    )}
  </head>
  <body data-clarity-mask="true">
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Consent />
  </body>
</html>
