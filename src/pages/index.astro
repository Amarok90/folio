---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Highlights from '../components/sections/Highlights.astro';
import Expertise from '../components/sections/Expertise.astro';
import Projects from '../components/sections/Projects.astro';
import Journey from '../components/sections/Journey.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import { media } from '../config/media';
import { profile } from '../data/profile';
---

<SiteLayout
  connectedHero
  person={{
    name: profile.identity.name,
    jobTitle: profile.identity.jobTitle,
    sameAs: profile.contact.links.map((link) => link.url),
  }}
>
  <Hero />
  <Highlights />
  <Expertise />
  <Projects thumbnails={media.projects} />
  <Journey />
  <About />
  <Contact image={media.contact} />
</SiteLayout>

<script>
  // Summary remains the native keyboard/no-JS control. The expanded content and
  // card border are also clickable, without hijacking links or text selection.
  document
    .querySelectorAll<HTMLDetailsElement>('details[data-card-disclosure]')
    .forEach((card) => {
      card.addEventListener('click', (event) => {
        if (
          !(event.target instanceof Element) ||
          event.target.closest(
            'summary, a, button, input, textarea, select, label',
          ) ||
          window.getSelection()?.isCollapsed === false
        )
          return;
        card.open = !card.open;
      });
    });
</script>
