---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import SectionHeading from '../components/layout/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import Icon from '../components/ui/Icon.astro';
import IconLink from '../components/ui/IconLink.astro';
import Metric from '../components/ui/Metric.astro';
import TextLink from '../components/ui/TextLink.astro';
import { site } from '../config/site';

const palette = [
  { name: 'Navy', role: 'Primary text', token: 'text' },
  { name: 'Ocean', role: 'Primary action', token: 'primary' },
  { name: 'Sky', role: 'Accent', token: 'accent' },
  { name: 'Mist', role: 'Secondary background', token: 'background-secondary' },
  { name: 'White', role: 'Surface', token: 'surface' },
];
const domains = [
  'Site identity & SEO',
  'Hero & professional highlights',
  'Expertise & skills',
  'Case studies & career experience',
  'Education & languages',
  'About, contact & CV',
];
---

<SiteLayout>
  <div class="preview-banner">
    <Container>
      <span class="preview-dot" aria-hidden="true"></span>
      <strong>Foundation preview</strong>
      <span>Task 01 · Design & architecture</span>
    </Container>
  </div>
  <section id="overview" aria-labelledby="overview-title" class="overview">
    <Container>
      <div class="overview-grid">
        <div class="overview-copy">
          <p class="eyebrow">A professional presence, thoughtfully built</p>
          <h1 id="overview-title">
            The foundation for
            <br />
            <span>what comes next.</span>
          </h1>
          <p class="overview-description">
            A clear visual language. A considered technical foundation. One
            professional story, ready to take shape.
          </p>
          <div class="overview-actions">
            <Button href="#design-system" icon="arrow">
              Explore the foundation
            </Button>
            <Button href="#components" variant="secondary">
              View components
            </Button>
          </div>
          <p class="owner-line">
            {site.identity.name}
            <span aria-hidden="true"> / </span>
            <span>{site.identity.jobTitle}</span>
          </p>
        </div>
        <Card variant="elevated" class="foundation-card">
          <div class="panel-top">
            <span class="eyebrow">FOLIO / 01</span>
            <Badge>Foundation</Badge>
          </div>
          <Icon name="layers" class="panel-icon" />
          <h2>
            A solid start.
            <br />
            Every detail considered.
          </h2>
          <div class="foundation-row">
            <Icon name="code" />
            <div>
              <strong>Static by design</strong>
              <span>Astro · TypeScript · Tailwind</span>
            </div>
            <Icon name="check" />
          </div>
          <div class="foundation-row">
            <Icon name="palette" />
            <div>
              <strong>One visual language</strong>
              <span>Centralized, responsive tokens</span>
            </div>
            <Icon name="check" />
          </div>
          <div class="foundation-row">
            <Icon name="shield" />
            <div>
              <strong>Built with care</strong>
              <span>Accessible, lean, maintainable</span>
            </div>
            <Icon name="check" />
          </div>
        </Card>
      </div>
      <div class="scope-note">
        <Icon name="file" />
        <p>
          <strong>A working foundation, with room for the real story.</strong>{' '}
          This is a component and architecture preview. The finished portfolio
          sections follow in Task 2.
        </p>
      </div>
    </Container>
  </section>

  <Section id="design-system">
    <SectionHeading
      id="design-system"
      eyebrow="01 / Visual language"
      title="Quiet confidence. Clear intention."
      description="The approved white, light-blue and navy direction, translated into reusable design decisions. Reference-informed approximations, ready to evolve with the original assets."
    />
    <div class="palette" aria-label="Design system palette">
      {palette.map((color) => (
        <div class="swatch">
          <div
            class="swatch-color"
            style={`--swatch: var(--color-${color.token})`}
          ></div>
          <strong>{color.name}</strong>
          <span>{color.role}</span>
        </div>
      ))}
    </div>
    <div class="type-grid">
      <Card class="type-sample">
        <div class="sample-label">
          <Icon name="type" />
          <span>Typography / Inter Variable</span>
        </div>
        <p class="display-sample">Clarity, by design.</p>
        <p>
          Elegant headings. Readable body copy. One self-hosted typeface, with a
          fluid scale that feels at home on every screen.
        </p>
        <div class="type-details">
          <span>Aa Bb Cc</span>
          <span>400 / 500 / 600 / 700</span>
        </div>
      </Card>
      <Card variant="tinted" class="principles-card">
        <p class="eyebrow">The design principles</p>
        <h3>Purpose in every detail.</h3>
        <ul>
          <li>
            <Icon name="check" />
            Space to read, and room to breathe.
          </li>
          <li>
            <Icon name="check" />
            Consistent color, shape and rhythm.
          </li>
          <li>
            <Icon name="check" />
            Visible focus. Comfortable touch targets.
          </li>
          <li>
            <Icon name="check" />
            Motion that respects your preferences.
          </li>
        </ul>
        <span class="caption">Mobile first · Fluid layouts · CSS first</span>
      </Card>
    </div>
  </Section>

  <Section id="components">
    <SectionHeading
      id="components"
      eyebrow="02 / Reusable components"
      title="Small parts. A coherent whole."
      description="Real HTML and Astro components, using the same tokens from navigation to footer. Every example below belongs to the foundation, not to the owner’s professional record."
    />
    <div class="component-grid">
      <Card class="component-sample">
        <p class="sample-label">Actions & links</p>
        <h3>A clear next step.</h3>
        <div class="button-stack">
          <Button href="#content" icon="arrow">
            Primary action
          </Button>
          <Button href="#readiness" variant="secondary" icon="arrow">
            Secondary action
          </Button>
          <Button disabled icon="download">
            CV pending
          </Button>
        </div>
        <div class="link-examples">
          <TextLink href="#readiness">Text link</TextLink>
          <IconLink href="#overview" label="Return to overview" icon="up" />
        </div>
        <p class="caption">
          The CV action stays disabled until a real document is supplied.
        </p>
      </Card>
      <Card class="component-sample">
        <p class="sample-label">Surfaces & labels</p>
        <h3>Structure without noise.</h3>
        <p>
          Soft borders and restrained shadows keep the focus on what matters.
        </p>
        <div class="badge-row">
          <Badge>Default badge</Badge>
          <Badge icon="check">With an icon</Badge>
        </div>
        <div class="nested-surface">
          <Icon name="layers" />
          <div>
            <strong>Elevated surface</strong>
            <p>One family of radii, spacing and shadows.</p>
          </div>
        </div>
        <p class="caption">
          Hover and focus states follow the same shared rules.
        </p>
      </Card>
      <Card class="component-sample">
        <p class="sample-label">Highlight / metric example</p>
        <Metric
          value="01"
          label="A consistent foundation"
          description="Illustrative component content. No career metric is implied."
          icon="complete"
        />
        <div class="metric-divider"></div>
        <p>
          A flexible highlight primitive, ready for verified achievements in the
          next phase.
        </p>
        <TextLink href="#content">Explore the content structure</TextLink>
      </Card>
    </div>
  </Section>

  <Section id="content">
    <div class="content-grid">
      <div>
        <SectionHeading
          id="content"
          eyebrow="03 / Content architecture"
          title="A place for every part of the story."
          description="Typed singletons and validated Astro Content Collections keep content separate from presentation. Structured JSON prepares the ground for Pages CMS."
        />
        <Badge icon="shield">Drafts stay out of public collections</Badge>
      </div>
      <Card class="content-domains">
        <p class="sample-label">Prepared content domains</p>
        <ul>
          {domains.map((domain, index) => (
            <li>
              <span class="domain-number">0{index + 1}</span>
              <span>{domain}</span>
              <Icon name="check" />
            </li>
          ))}
        </ul>
        <p class="caption">
          Only the supplied name and professional title are populated. Unknown
          information stays unpopulated.
        </p>
      </Card>
    </div>
  </Section>

  <Section id="readiness">
    <SectionHeading
      id="readiness"
      eyebrow="04 / Ready for the next chapter"
      title="The groundwork is in place."
      description="A foundation for the final single-page portfolio, with clear boundaries between what is implemented and what still needs original source material."
    />
    <div class="readiness-grid">
      <Card>
        <Icon name="code" />
        <h3>Technical foundation</h3>
        <p>
          Static rendering, strict types, reusable components, content
          validation and automated quality gates.
        </p>
        <Badge>Implemented in Task 1</Badge>
      </Card>
      <Card>
        <Icon name="image" />
        <h3>Original assets</h3>
        <p>
          Approved portrait, alpine imagery and logo source files are needed
          before the final sections are built.
        </p>
        <Badge>Source material pending</Badge>
      </Card>
      <Card>
        <Icon name="file" />
        <h3>The professional story</h3>
        <p>
          Verified experience, case studies, achievements, contact details and a
          current CV will complete the content.
        </p>
        <Badge>Content pending</Badge>
      </Card>
    </div>
    <div class="closing-note">
      <p>Built for a lasting professional presence.</p>
      <TextLink href="#overview">Back to the foundation</TextLink>
    </div>
  </Section>
</SiteLayout>

<style>
  .preview-banner {
    border-bottom: 1px solid var(--color-divider);
    padding-block: var(--space-3);
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    background: var(--color-background-secondary);
  }
  .preview-banner .page-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }
  .preview-banner strong {
    font-weight: var(--weight-semibold);
  }
  .preview-banner .page-container > span:last-child {
    margin-left: auto;
  }
  .preview-dot {
    width: var(--space-2);
    height: var(--space-2);
    background: var(--color-primary);
    border-radius: var(--radius-pill);
  }
  .overview {
    padding-block: var(--section-space) var(--space-8);
    background: var(--color-background-secondary);
    border-bottom: 1px solid var(--color-divider);
  }
  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    align-items: center;
    gap: var(--space-12);
  }
  h1 {
    font-size: var(--text-display);
    margin-block: var(--space-6);
  }
  h1 span {
    color: var(--color-primary);
  }
  .overview-description {
    color: var(--color-text-secondary);
    font-size: var(--text-h4);
    max-width: 48ch;
  }
  .overview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-8);
  }
  .owner-line {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }
  .owner-line > span {
    margin-left: var(--space-2);
  }
  .panel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .panel-top .eyebrow::before {
    display: none;
  }
  .foundation-card :global(.panel-icon) {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-primary);
    margin-block: var(--space-8) var(--space-5);
  }
  .foundation-card h2 {
    font-size: var(--text-h3);
    margin-bottom: var(--space-8);
  }
  .foundation-row {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-divider);
  }
  .foundation-row :global(.icon) {
    color: var(--color-primary);
  }
  .foundation-row :global(.icon:last-child) {
    margin-left: auto;
    width: 1rem;
  }
  .foundation-row div {
    display: grid;
    gap: var(--space-1);
  }
  .foundation-row strong {
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }
  .foundation-row div span {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  .scope-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-8);
    margin-top: var(--space-10);
    border-top: 1px solid var(--color-border);
    max-width: 86ch;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
  .scope-note :global(.icon) {
    margin-top: var(--space-1);
    color: var(--color-primary);
  }
  .scope-note strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }
  .palette {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .swatch {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    min-width: 0;
  }
  .swatch-color {
    height: clamp(4rem, 8vw, 7rem);
    background: var(--swatch);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    margin-bottom: var(--space-3);
  }
  .swatch strong,
  .swatch span {
    padding-inline: var(--space-2);
  }
  .swatch strong {
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }
  .swatch span {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  .type-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--grid-gap);
  }
  .sample-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
  }
  .type-sample .display-sample {
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    margin-block: var(--space-8) var(--space-5);
  }
  .type-details {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-divider);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  .principles-card h3 {
    margin-block: var(--space-5);
  }
  .principles-card ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-6);
  }
  .principles-card li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  .principles-card li :global(.icon) {
    color: var(--color-primary);
    margin-top: var(--space-1);
  }
  .caption {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .component-grid,
  .readiness-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .component-sample {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .component-sample h3 {
    font-size: var(--text-h4);
  }
  .component-sample > p:not(.sample-label, .caption) {
    font-size: var(--text-small);
  }
  .button-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .link-examples {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    width: 100%;
  }
  .component-sample .caption {
    margin-top: auto;
  }
  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .nested-surface {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-small);
    border: 1px solid var(--color-divider);
    box-shadow: var(--shadow-card);
  }
  .nested-surface :global(.icon) {
    color: var(--color-primary);
    margin-top: var(--space-1);
  }
  .nested-surface strong {
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
  }
  .nested-surface p {
    font-size: var(--text-caption);
    margin-top: var(--space-1);
  }
  .metric-divider {
    height: 1px;
    background: var(--color-divider);
    width: 100%;
  }
  .content-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
    align-items: center;
  }
  .content-domains ul {
    list-style: none;
    padding: 0;
    margin-block: var(--space-3) var(--space-5);
  }
  .content-domains li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-divider);
    font-size: var(--text-small);
  }
  .content-domains li :global(.icon) {
    margin-left: auto;
    color: var(--color-primary);
    width: 1rem;
  }
  .domain-number {
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }
  .readiness-grid :global(.card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .readiness-grid :global(.card > .icon) {
    color: var(--color-primary);
  }
  .readiness-grid h3 {
    font-size: var(--text-h4);
  }
  .readiness-grid p {
    font-size: var(--text-small);
  }
  .readiness-grid :global(.badge) {
    margin-top: auto;
  }
  .closing-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-divider);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
  @media (width < 64rem) {
    .overview-grid {
      gap: var(--space-6);
    }
    .component-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .content-grid {
      gap: var(--space-6);
    }
  }
  @media (width < 48rem) {
    .overview-grid,
    .type-grid,
    .content-grid,
    .readiness-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .overview-grid {
      gap: var(--space-10);
    }
    .overview-copy {
      max-width: 38rem;
    }
    .foundation-card h2 {
      font-size: var(--text-h3);
    }
    .palette {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .swatch-color {
      height: 5rem;
    }
    .content-grid {
      gap: var(--space-8);
    }
    .preview-banner .page-container > span:last-child {
      margin-left: 0;
    }
    .owner-line > span:last-child {
      display: block;
      margin: 0;
    }
    .owner-line > span:first-child {
      display: none;
    }
  }
  @media (width < 36rem) {
    .component-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .overview-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .overview-actions :global(.button) {
      width: 100%;
    }
    .palette {
      gap: var(--space-2);
    }
    .swatch span {
      line-height: 1.4;
    }
  }
</style>
