---
// Static GitHub Pages shortcut; authentication remains entirely with Pages CMS/GitHub.
const cmsURL = 'https://app.pagescms.org/Amarok90/folio/main/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="refresh" content={`0;url=${cmsURL}`} />
    <title>Manage FOLIO content</title>
  </head>
  <body data-clarity-mask="true">
    <main>
      <h1>Manage FOLIO content</h1>
      <p>
        <a href={cmsURL}>Continue to Pages CMS</a>
      </p>
      <p>Use your existing GitHub sign-in to manage FOLIO.</p>
    </main>
  </body>
</html>
