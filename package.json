{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:base": "node scripts/test-base.mjs",
    "build": "npm run content:check && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "audit": "npm audit --audit-level=high",
    "validate": "npm run check && npm run lint && npm run format:check && npm run test:unit && npm run content:check && npm run test:cms && npm run audit && npm run test:base && npm run build && npm run test:e2e && npm run test:analytics && npm run test:lighthouse",
    "content:check": "node scripts/validate-content.mjs",
    "test:cms": "node --test --test-concurrency=1 tests/integration/cms-workflows.test.mjs",
    "test:analytics": "playwright test --config playwright.analytics.config.ts",
    "test:lighthouse": "node scripts/test-lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@lucide/astro": "1.61.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
